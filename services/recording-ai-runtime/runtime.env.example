# Copy to /opt/sokuji-recording-runtime/runtime.env. Do not commit the real token.
SOKUJI_RUNTIME_DATA=/var/lib/sokuji-recording-runtime
SOKUJI_RUNTIME_BIND=192.168.50.186
SOKUJI_RUNTIME_TOKEN=replace-with-a-random-32-byte-token
# Temporary package-test configuration delivery. Keep disabled outside a
# controlled test window. Generate the password hash with
# ./generate_test_config_password_hash.py and keep the real JSON file at 0600.
SOKUJI_TEST_CONFIG_ENABLED=false
SOKUJI_TEST_CONFIG_USERNAME=
SOKUJI_TEST_CONFIG_PASSWORD_HASH=
SOKUJI_TEST_CONFIG_FILE=/var/lib/sokuji-recording-runtime/test-config.json
# true only for infrastructure/API validation before a frozen MOSS worker exists.
SOKUJI_RUNTIME_FAKE=true
SOKUJI_RUNTIME_PROFILE_REVISION=runtime-poc-20260831-01
SOKUJI_INPUT_RETENTION_DAYS=7
SOKUJI_RESULT_RETENTION_DAYS=30
SOKUJI_CLEANUP_INTERVAL_SECONDS=21600
SOKUJI_MOSS_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize
# Pin to a commit hash only after the MOSS benchmark gate, never to a moving branch/tag.
SOKUJI_MOSS_MODEL_REVISION=unconfigured
# Internal-only URL of the SGLang/vLLM MOSS Worker. Leave empty until the image and model
# revision have passed the benchmark gate; it must never be published on the LAN.
SOKUJI_MOSS_WORKER_URL=
SOKUJI_MOSS_WORKER_TIMEOUT_SECONDS=7200
# A 60-minute MOSS request needs its audio embeddings plus transcript to fit
# in the vLLM context. Tune this with max_model_len as one pair.
SOKUJI_MOSS_MAX_NEW_TOKENS=24000
SOKUJI_MOSS_GPU_MEMORY_UTILIZATION=0.82
SOKUJI_MOSS_MAX_MODEL_LEN=72000
# vLLM's MOSS adapter is patched in the pinned worker image to reserve audio
# encoder cache for this duration. It is a 60-minute startup budget, not a
# model limitation; retain it only after the target GPU's long-audio benchmark.
SOKUJI_MOSS_ENCODER_CACHE_MAX_AUDIO_SECONDS=3600
# vLLM rejects longer audio before the MOSS adapter runs unless this decode
# guard is raised to the same value as the encoder-cache budget.
SOKUJI_MOSS_MAX_AUDIO_DECODE_DURATION_SECONDS=3600
# Keep MOSS unavailable to desktop live jobs until this duration has passed a
# real benchmark. Set it to 3600 only after the 60-minute smoke test succeeds.
SOKUJI_MOSS_VALIDATED_MAX_DURATION_SEC=0
# vLLM CUDA 13 wheel index referenced by the official MOSS model card.
SOKUJI_VLLM_EXTRA_INDEX=https://wheels.vllm.ai/68b4a1d582818e67adc903bf1b8fc5a5447da2fa/cu130
# Required by Compose interpolation even while the `moss` profile is disabled.
SOKUJI_MOSS_IMAGE=invalid.local/sokuji-moss:disabled
# FunASR Meeting uses an independent CUDA 13 image and cache. Keep this URL
# empty unless `docker compose --profile funasr up -d funasr-worker` is active.
SOKUJI_FUNASR_WORKER_URL=
SOKUJI_FUNASR_WORKER_TIMEOUT_SECONDS=7200
SOKUJI_FUNASR_MODEL_ID=FunAudioLLM/Fun-ASR-Nano-2512
SOKUJI_FUNASR_MODEL_REVISION=unconfigured
SOKUJI_FUNASR_MODEL_HUB=ms
SOKUJI_FUNASR_VAD_MODEL_ID=fsmn-vad
SOKUJI_FUNASR_VAD_MODEL_REVISION=unconfigured
SOKUJI_FUNASR_VAD_MAX_SINGLE_SEGMENT_TIME_MS=30000
SOKUJI_FUNASR_SPEAKER_MODEL_ID=iic/speech_eres2netv2_sv_zh-cn_16k-common
SOKUJI_FUNASR_SPEAKER_MODEL_REVISION=unconfigured
# Initial profile value. Freeze it only after the target RTX 3060 smoke test.
SOKUJI_FUNASR_GPU_MEMORY_UTILIZATION=0.5
# Benchmark provenance only. Set this after measuring the verified duration;
# it does not disable a running FunASR Worker.
SOKUJI_FUNASR_VALIDATED_MAX_DURATION_SEC=0
